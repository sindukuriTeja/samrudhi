# Copy to .env to customise the stack.

# Which model Ollama should pull & serve.
# Good small options: llama3.1:8b (default), llama3.1:4b (faster),
# qwen2.5:7b, mistral:7b, phi3:3.8b
OLLAMA_MODEL=llama3.1:8b

# Force the deterministic offline engine instead of Ollama:
# LLM_PROVIDER=mock

# LLM_PROVIDER=ollama